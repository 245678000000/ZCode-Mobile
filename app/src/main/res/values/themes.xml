<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window colours only; the Compose theme (ui/theme) owns everything drawn on screen. -->
    <style name="Theme.ZCodeMobile" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/zcode_window</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorPrimary">@color/zcode_fg</item>
    </style>
</resources>

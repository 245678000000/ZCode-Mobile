<?xml version="1.0" encoding="utf-8"?>
<!--
  LAN Remote Control sessions are often served over HTTP on a private network.
  HTTPS pages still reject mixed content inside WebView.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
